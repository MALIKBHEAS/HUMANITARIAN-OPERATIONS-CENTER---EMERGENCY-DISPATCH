# ==========================================
# EOA Global Backend - Environment Settings
# ==========================================

# Application Metadata
PROJECT_NAME="EOA Global - Emergency Orchestrator Agent"
VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1

# Security & Authentication
SECRET_KEY=eoa_enterprise_super_secret_jwt_key_must_be_changed_in_prod_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL + PostGIS Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=eoa_global_db

# CORS Allowed Origins (Comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000
